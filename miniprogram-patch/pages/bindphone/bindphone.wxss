.pk { height: 44px; line-height: 44px; padding: 0 12px; border: 1px solid #dfe6e4; border-radius: 10px; background: #fff; font-size: 15px; margin-right: 8px; white-space: nowrap; }
.ipt { height: 44px; padding: 0 12px; border: 1px solid #dfe6e4; border-radius: 10px; background: #fff; font-size: 16px; }
.cap { width: 110px; height: 44px; margin-left: 8px; border-radius: 8px; background: #f4f8f7; }
.send { margin-left: 8px; min-width: 104px; font-size: 14px; }
.err { background: #ffecec; color: #c62828; border-radius: 10px; padding: 8px 10px; font-size: 13px; margin-bottom: 8px; }
.tip { font-size: 12px; color: #6b7a78; margin-top: 10px; line-height: 1.6; }
